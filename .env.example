# Переменные для docker-compose.yml в корне репозитория.
# Ключи парсеров лежат в их директориях, например telegram-parser/.env

# Интерфейс, на котором открыты порты метрик 9101 и 9102.
# 127.0.0.1 — только локально; 0.0.0.0 — если Prometheus на другой машине
METRICS_BIND=127.0.0.1

# Прокси для lighter-price-parser (telegram-parser берёт PROXY_URL из своего .env).
# Пример: socks5://user:pass@172.17.0.1:1080; пусто — без прокси
PROXY_URL=

# Директория на хосте с сессией Telegram (файл telegram.session)
TG_SESSION_DIR=/opt/67-trading-secrets/telegram-parser
