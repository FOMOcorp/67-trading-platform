# Public Binance data: API keys and Binance account are not required.
STORAGE=csv
OUTPUT_DIR=data/live
SYMBOLS=BTCUSDT
TIMEFRAMES=1m

COLLECT_CANDLES_INTERVAL_SECONDS=60
COLLECT_TICKERS_INTERVAL_SECONDS=10
COLLECT_FUNDING_INTERVAL_SECONDS=300
COLLECT_OPEN_INTEREST_INTERVAL_SECONDS=60
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=4
HTTP_BACKOFF_BASE_SECONDS=1
LOG_LEVEL=INFO

# Used only by --storage clickhouse / Docker Compose.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=crypto
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me
