# Ключ API: https://twitterapi.io/dashboard
TWITTERAPI_IO_KEY=

# Аккаунты через запятую, @ можно не писать
TW_ACCOUNTS=VitalikButerin,cz_binance,saylor

# Прокси, пусто = без прокси. Примеры:
#   socks5://user:pass@host:1080
#   http://user:pass@host:3128
PROXY_URL=

# Путь к базе (в контейнере это /app/data)
DB_PATH=data/tweets.db

# Сохранять ли ответы аккаунта другим пользователям (true/false)
INCLUDE_REPLIES=false

# Как часто проверять новые твиты, секунды (минимум 60).
# Каждая проверка — минимум один платный запрос на аккаунт
POLL_SECONDS=300
# Сколько страниц (~20 твитов) новых твитов забирать за одну проверку
POLL_MAX_PAGES=10

# Фоновая загрузка старых твитов: за сколько дней назад.
# 0 — не загружать, -1 — вся доступная история
HISTORY_DAYS=365
# Пауза между запросами истории, секунды (плюс случайные 0–50%).
# Один запрос = страница до ~20 твитов
HISTORY_DELAY_SECONDS=1

# Порт метрик Prometheus (/metrics), 0 — выключить
METRICS_PORT=9103

LOG_LEVEL=INFO
