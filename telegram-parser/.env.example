# Ключи приложения: https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# Номер аккаунта для первого входа (команда login), формат +79991234567
TG_PHONE=

# Название папки (dialog folder) в Telegram, без учёта регистра
TG_FOLDER=crypto

# Прокси, пусто = без прокси. Примеры:
#   socks5://user:pass@host:1080
#   http://user:pass@host:3128
#   mtproto://<secret>@host:443
# Прокси на хост-машине из контейнера: socks5://host.docker.internal:1080
PROXY_URL=

# Пути к сессии и базе (в контейнере это /app/data, смонтирована из ./data)
TG_SESSION_PATH=data/telegram.session
DB_PATH=data/messages.db

# Как часто перечитывать состав папки, секунды
FOLDER_REFRESH_SECONDS=300
# Сколько пропущенных сообщений на чат добирать после перезапуска
CATCHUP_LIMIT=500

# Фоновая загрузка старых сообщений: за сколько дней назад.
# 0 — не загружать, -1 — вся история чатов
HISTORY_DAYS=90
# Пауза между запросами истории, секунды (плюс случайные 0–50%).
# Один запрос = до 100 сообщений. Меньше 2–3 с ставить не стоит
HISTORY_DELAY_SECONDS=5

# Порт метрик Prometheus (/metrics), 0 — выключить
METRICS_PORT=9101

LOG_LEVEL=INFO
